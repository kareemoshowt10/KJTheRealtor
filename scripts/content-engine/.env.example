# All keys below are optional. The pipeline always produces a full brief —
# each key just upgrades one stage from an evergreen template to live data.

# Federal Reserve Economic Data (FRED) — free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Powers Rate Watch + the payment-savings math in every category's hook.
FRED_API_KEY=

# Firecrawl — same key already used by scripts/market-pulse (https://firecrawl.dev)
# Powers the day's supporting headline/stat search (Redfin/Zillow/NAR/BiggerPockets/Inman/Reddit coverage).
FIRECRAWL_API_KEY=

# Slack incoming webhook — posts the finished brief to a channel for morning review.
SLACK_WEBHOOK_URL=

# Notion — drops the brief into a database as a page for the content calendar.
# Integration needs "Insert content" access on the target database.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Override the assumed loan amount used for "X% rate drop saves $Y/month" math.
# Defaults to 420000 (~80% LTV on the national median existing-home price).
CONTENT_LOAN_AMOUNT=
