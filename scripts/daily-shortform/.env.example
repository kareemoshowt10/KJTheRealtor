# All optional. The pipeline runs today on RSS alone (Mortgage News Daily,
# Inman, BiggerPockets) with no keys set at all — these just unlock the
# stubbed sources described in marketing/daily-shortform-pipeline.md.

# Free signup at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Free signup at api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Register an app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Used to tighten the rules-based script template into Kareem's voice.
# Without this, generate.mjs ships the plain template untouched.
OPENAI_API_KEY=
