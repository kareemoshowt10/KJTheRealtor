# Required — same Firecrawl account already used by scripts/market-pulse.
# Powers the sources that have no public API or RSS feed (Redfin Data Center,
# Google Trends, Reddit threads, NAR monthly report pages).
FIRECRAWL_API_KEY=fc-your-key-here

# Required — writes the ranked insight into a script + visual brief.
# Any Claude model works; a fast/cheap one is plenty for this job.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — Census Bureau API is keyless for low volume, but a free key
# (https://api.census.gov/data/key_signup.html) raises the rate limit and
# avoids getting throttled on a shared runner IP.
CENSUS_API_KEY=

# Optional delivery hooks. Leave unset to skip that delivery channel — the
# packet is always written to content/daily-microlessons/ regardless.
NOTION_API_KEY=
NOTION_DATABASE_ID=
SLACK_WEBHOOK_URL=
