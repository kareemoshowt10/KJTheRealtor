# Required for live mode (headline search). Get one at firecrawl.dev.
# Without this set, generate.mjs runs in TEMPLATE mode: it still produces a
# fully-formed, clearly-labeled script + visual brief so the pipeline stays
# reviewable, but with placeholder data instead of a real headline.
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: post the finished brief to a Slack channel each morning.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
